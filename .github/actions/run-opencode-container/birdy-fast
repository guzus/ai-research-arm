#!/bin/sh
set -eu

# The host's birdy-fast talks to a localhost daemon, which is deliberately not
# reachable from this container. Preserve the prompt-facing command contract by
# routing to the pinned in-image birdy binary. Log command names only: arguments
# may contain private URLs, cookies, or user-provided search text.
export BIRDY_READ_ONLY=1
LOG_PATH="${BIRDY_TOOL_LOG_PATH:-/workspace/.twitter-input/birdy-tool-log.jsonl}"

command_name=""
skip_next=0
for arg in "$@"; do
  if [ "$skip_next" = "1" ]; then
    skip_next=0
    continue
  fi
  case "$arg" in
    --account|-a|--strategy|-s|--vpn-server|--auth-token|--ct0|--chrome-profile|--chrome-profile-dir|--firefox-profile|--cookie-timeout|--cookie-source|--media|--alt|--timeout|--quote-depth|-n|--count)
      skip_next=1
      ;;
    --*=*|-*)
      ;;
    about|activity|bookmarks|check|follow|followers|following|home|likes|list-timeline|lists|mentions|news|post|query-ids|read|replies|reply|search|thread|trending|tweet|unbookmark|unfollow|user-tweets|whoami)
      command_name=$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')
      break
      ;;
    *) ;;
  esac
done

log_event() {
  blocked="$1"
  ok="$2"
  exit_code="$3"
  duration_ms="$4"
  mkdir -p -- "$(dirname -- "$LOG_PATH")" 2>/dev/null || true
  jq -cn \
    --arg command "${command_name:-unknown}" \
    --argjson blocked "$blocked" \
    --argjson ok "$ok" \
    --argjson exit_code "$exit_code" \
    --argjson duration_ms "$duration_ms" \
    '{ts:(now|floor),tool:"birdy-fast",command:$command,blocked:$blocked,
      ok:$ok,exit_code:$exit_code,duration_ms:$duration_ms,cached:false,redacted:true}' \
    >> "$LOG_PATH" 2>/dev/null || true
}

case "$command_name" in
  tweet|post|reply|follow|unfollow|unbookmark)
    log_event true false 2 0
    echo "birdy-fast: mutating command '$command_name' is disabled in read-only workflow mode" >&2
    exit 2
    ;;
esac

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/birdy-fast.XXXXXX")
trap 'rm -rf -- "$tmp_dir"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

start_ms=$(jq -nr 'now * 1000 | floor')
set +e
birdy "$@" > "$tmp_dir/stdout" 2> "$tmp_dir/stderr"
exit_code=$?
set -e
end_ms=$(jq -nr 'now * 1000 | floor')
duration_ms=$((end_ms - start_ms))

if [ "$exit_code" -eq 0 ]; then
  ok=true
else
  ok=false
fi
log_event false "$ok" "$exit_code" "$duration_ms"
cat "$tmp_dir/stdout"
cat "$tmp_dir/stderr" >&2
exit "$exit_code"

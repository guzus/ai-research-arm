{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(.agent-input/aradio/**)",
      "Edit(.tmp/aradio/edit.json)"
    ],
    "deny": [
      "Bash",
      "Task",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Skill",
      "ToolSearch",
      "SendMessage",
      "ListAgents",
      "Workflow",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "EnterWorktree",
      "ExitWorktree",
      "ReportFindings",
      "TaskStop",
      "Glob",
      "Grep",
      "mcp__*",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(//run/**)",
      "Read(//dev/**)",
      "Read(//etc/**)",
      "Read(//root/**)",
      "Read(//home/**)",
      "Read(//tmp/**)",
      "Read(~/**)",
      "Read(.git/**)",
      "Edit(.env*)",
      "Edit(.git/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(.agent-input/**)",
      "Edit(research/**)",
      "Edit(data/**)",
      "Edit(scripts/**)",
      "Edit(dashboard/**)",
      "Edit(docs/**)",
      "Edit(prompts/**)"
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(docs/wiki-schema.md)",
      "Read(research/digest/**)",
      "Read(research/models/tickets/**)",
      "Read(research/wiki/**)",
      "Glob",
      "Edit(research/wiki/**)",
      "Bash(uv run python scripts/wiki_search.py \"*)",
      "Bash(uv run python scripts/check_wiki.py)",
      "Bash(uv run python scripts/check_wiki.py --lint)",
      "Bash(uv run python scripts/build_wiki_index.py)",
      "Bash(git add research/wiki/*)",
      "Bash(git commit -m *)"
    ],
    "deny": [
      "Task",
      "Agent",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "Skill",
      "ToolSearch",
      "SendMessage",
      "ListAgents",
      "Workflow",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "EnterWorktree",
      "ExitWorktree",
      "ReportFindings",
      "TaskStop",
      "Grep",
      "mcp__*",
      "Read(//proc/**)",
      "Read(//sys/**)",
      "Read(//run/**)",
      "Read(//dev/**)",
      "Read(//etc/**)",
      "Read(//root/**)",
      "Read(//home/**)",
      "Read(//tmp/**)",
      "Read(~/**)",
      "Read(.git/**)",
      "Edit(.env*)",
      "Edit(.git/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(.agent-input/**)",
      "Edit(data/**)",
      "Edit(scripts/**)",
      "Edit(dashboard/**)",
      "Edit(docs/**)",
      "Edit(prompts/**)",
      "Edit(research/wiki-translations/**)"
    ]
  }
}
